---
import { facts, type FactId } from '../data/facts';
import StatusBadge from './StatusBadge.astro';
interface Props { ids: FactId[]; compact?: boolean }
const { ids, compact = false } = Astro.props;
---
<ul class="facts">
  {ids.map((id) => {
    const f = facts[id];
    return (
      <li>
        <p class="claim">{compact ? f.short : f.claim}</p>
        <p class="meta"><StatusBadge status={f.status} /> <span class="date">{f.date}</span></p>
        {!compact && <p class="ctx">{f.context}</p>}
      </li>
    );
  })}
</ul>

<style>
  .facts { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--color-border); }
  li { padding-block: var(--space-4); border-bottom: 1px solid var(--color-border); max-width: 78ch; }
  p { margin: 0; }
  .claim { color: var(--color-text); }
  .meta { margin-top: var(--space-2); display: flex; gap: var(--space-3); align-items: center; }
  .date { color: var(--color-text-muted); font-size: var(--step--1); }
  .ctx { margin-top: var(--space-2); color: var(--color-text-muted); font-size: var(--step--1); }
</style>
