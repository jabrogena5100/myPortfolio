---
import { site, nav, hasContact } from '../data/site';
---
<footer class="site-footer">
  <div class="container grid">
    <p class="who"><span class="name">{site.name}</span><br />Backend systems and AWS infrastructure.</p>
    <nav aria-label="Footer">
      <ul>{nav.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
    </nav>
    <p class="note">Personal portfolio. No client work is listed.{hasContact ? '' : ' Contact details are being added.'}</p>
  </div>
</footer>

<style>
  .site-footer { margin-top: var(--space-9); border-top: 1px solid var(--color-border); padding-block: var(--space-7); color: var(--color-text-muted); font-size: var(--step--1); }
  .grid { display: grid; gap: var(--space-5); }
  .name { font-family: var(--font-display-stack); font-weight: 600; letter-spacing: -0.02em; font-size: var(--step-0); color: var(--color-text); }
  ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-5); }
  li a { display: inline-block; padding: var(--space-3) 0; min-height: 44px; box-sizing: border-box; }
  p { margin: 0; }
  @media (min-width: 48rem) { .grid { grid-template-columns: 1fr auto; } .note { grid-column: 1 / -1; } }
</style>
