---
import Base from './Base.astro';
interface Props {
  title: string;
  description: string;
  kind: string;
  name: string;
  status: string;
  stack: string;
  meta: [string, string][];
  toc: [string, string][];
}
const { title, description, kind, name, status, stack, meta, toc } = Astro.props;
---
<Base title={title} description={description}>
  <article class="container cs">
    <header class="head">
      <p class="eyebrow">{kind}</p>
      <h1>{name}</h1>
      <p class="status"><strong>Status today:</strong> {status}</p>
      <dl class="meta">
        <div><dt>Stack</dt><dd>{stack}</dd></div>
        {meta.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
      </dl>
    </header>
    <nav class="toc" aria-label="On this page">
      <p class="eyebrow">On this page</p>
      <ol>{toc.map(([id, t]) => <li><a href={`#${id}`}>{t}</a></li>)}</ol>
    </nav>
    <div class="content"><slot /></div>
  </article>
</Base>

<style>
  .cs { padding-block: var(--space-8) 0; }
  h1 { font-size: var(--step-5); margin-top: var(--space-3); }
  .status { color: var(--color-sage); max-width: var(--measure); margin: var(--space-5) 0 0; font-size: var(--step-0); }
  @media (min-width: 48rem) { .status { font-size: var(--step-1); } }
  .status strong { color: var(--color-text); font-weight: 600; }
  .meta { display: grid; gap: var(--space-4); margin: var(--space-6) 0 0; }
  .meta div { border-top: 1px solid var(--color-border); padding-top: var(--space-3); }
  dt { color: var(--color-text-muted); font-size: var(--step--1); letter-spacing: 0.06em; text-transform: uppercase; }
  dd { margin: var(--space-1) 0 0; max-width: var(--measure); }
  .toc { margin-top: var(--space-7); }
  .toc ol { list-style: none; margin: var(--space-3) 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-5); }
  .toc a { display: inline-block; padding: var(--space-2) 0; min-height: 44px; box-sizing: border-box; }
  .content { margin-top: var(--space-6); }
  @media (min-width: 64rem) { .meta { grid-template-columns: repeat(3, 1fr); } }
</style>
