# Copy to terraform.tfvars (git-ignored) and edit. Nothing here is applied until you run it yourself.
#
# RECOMMENDED FIRST PLAN ("Plan A", see docs/deploy/runbook.md): the default CloudFront address
# plus a cost alert. No domain, no DNS, nothing to undo at a registrar. Expect about 12 resources.

bucket_name = "REPLACE-with-a-globally-unique-lowercase-name"

# Cost alert (recommended). It only emails you; it does not stop spending. The amount is a threshold you choose.
# Uncomment and set both, or leave both commented. A placeholder fails at plan time on purpose.
# budget_amount_usd = 5
# budget_email      = "REPLACE-with-your-email"

# LATER ("Plan C"), a custom domain. Two ways; pick one.
#
# (a) DNS in Route 53 (Terraform creates the records). Set both together:
# domain_name    = "example.com"
# hosted_zone_id = "ZXXXXXXXXXXXXX"     # starts with Z; Route 53 console > Hosted zones
#
# (b) DNS anywhere else, for example a domain registered at Cloudflare (it must keep Cloudflare nameservers).
#     Terraform creates only the certificate and the CloudFront alias; you add the records it prints:
# domain_name  = "example.com"
# external_dns = true
